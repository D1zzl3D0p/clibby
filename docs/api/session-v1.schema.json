{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clibby:session-api:1",
  "title": "Clibby session API major 1",
  "description": "Accepted JSON-RPC requests and successful/error response envelopes. LF framing, UTF-8 validity, handshake, rate/size limits, monotonic sequence/TTL and OS permissions are enforced outside JSON Schema. Unknown object fields are additive and tolerated. CLI success output is the result object, not its envelope.",
  "oneOf": [
    {
      "$ref": "#/$defs/helloRequest"
    },
    {
      "$ref": "#/$defs/updateRequest"
    },
    {
      "$ref": "#/$defs/clearRequest"
    },
    {
      "$ref": "#/$defs/stateRequest"
    },
    {
      "$ref": "#/$defs/helloResponse"
    },
    {
      "$ref": "#/$defs/updateResponse"
    },
    {
      "$ref": "#/$defs/clearResponse"
    },
    {
      "$ref": "#/$defs/stateResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "requestId": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ]
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}(?![\\s\\S])"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ttl": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 120
    },
    "status": {
      "enum": [
        "working",
        "needs_input",
        "completed",
        "failed"
      ]
    },
    "label": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
    },
    "helloParams": {
      "type": "object",
      "properties": {
        "api_major": {
          "const": 1
        }
      },
      "required": [
        "api_major"
      ],
      "additionalProperties": true
    },
    "updateParams": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sessionId"
        },
        "session_id": {
          "$ref": "#/$defs/sessionId"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "seq": {
          "$ref": "#/$defs/sequence"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "ttl": {
          "$ref": "#/$defs/ttl"
        },
        "source_url": {
          "$ref": "#/$defs/sourceUrl"
        }
      },
      "required": [
        "source_id",
        "session_id",
        "label",
        "seq",
        "status"
      ],
      "additionalProperties": true
    },
    "clearParams": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sessionId"
        },
        "session_id": {
          "$ref": "#/$defs/sessionId"
        },
        "seq": {
          "$ref": "#/$defs/sequence"
        }
      },
      "required": [
        "source_id",
        "session_id",
        "seq"
      ],
      "additionalProperties": true
    },
    "stateParams": {
      "type": "object",
      "maxProperties": 0
    },
    "updateResult": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "#/$defs/sequence"
        },
        "ttl": {
          "$ref": "#/$defs/ttl"
        }
      },
      "required": [
        "seq",
        "ttl"
      ],
      "additionalProperties": true
    },
    "clearResult": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "#/$defs/sequence"
        },
        "cleared": {
          "type": "boolean"
        }
      },
      "required": [
        "seq",
        "cleared"
      ],
      "additionalProperties": true
    },
    "session": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sessionId"
        },
        "session_id": {
          "$ref": "#/$defs/sessionId"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "seq": {
          "$ref": "#/$defs/sequence"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "ttl_remaining": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "acknowledged": {
          "type": "boolean"
        },
        "source_url": {
          "$ref": "#/$defs/sourceUrl"
        }
      },
      "required": [
        "source_id",
        "session_id",
        "label",
        "seq",
        "status",
        "ttl_remaining",
        "acknowledged"
      ],
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "frame_bytes": {
          "const": 16384
        },
        "clients": {
          "const": 16
        },
        "session_records": {
          "const": 32
        },
        "pending_requests": {
          "const": 64
        },
        "tx_bytes": {
          "const": 65536
        },
        "incomplete_frame_seconds": {
          "const": 5
        },
        "requests_per_second": {
          "const": 10
        },
        "burst": {
          "const": 20
        },
        "id_characters": {
          "const": 64
        },
        "label_characters": {
          "const": 120
        },
        "ttl_default": {
          "const": 120
        },
        "ttl_max": {
          "const": 3600
        }
      },
      "required": [
        "frame_bytes",
        "clients",
        "session_records",
        "pending_requests",
        "tx_bytes",
        "incomplete_frame_seconds",
        "requests_per_second",
        "burst",
        "id_characters",
        "label_characters",
        "ttl_default",
        "ttl_max"
      ],
      "additionalProperties": true
    },
    "helloResult": {
      "type": "object",
      "properties": {
        "api_major": {
          "const": 1
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 4,
          "uniqueItems": true,
          "allOf": [
            {
              "contains": {
                "const": "hello"
              }
            },
            {
              "contains": {
                "const": "session.update"
              }
            },
            {
              "contains": {
                "const": "session.clear"
              }
            },
            {
              "contains": {
                "const": "state.get"
              }
            }
          ]
        },
        "statuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/status"
          },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "required": [
        "api_major",
        "methods",
        "statuses",
        "limits"
      ],
      "additionalProperties": true
    },
    "stateResult": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "paused": {
          "type": "boolean"
        },
        "character": {
          "type": "string"
        },
        "foreground": {
          "oneOf": [
            {
              "$ref": "#/$defs/session"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session"
          },
          "maxItems": 32
        }
      },
      "required": [
        "visible",
        "paused",
        "character",
        "foreground",
        "sessions"
      ],
      "additionalProperties": true
    },
    "helloRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "hello"
        },
        "params": {
          "$ref": "#/$defs/helloParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "updateRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "session.update"
        },
        "params": {
          "$ref": "#/$defs/updateParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "clearRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "session.clear"
        },
        "params": {
          "$ref": "#/$defs/clearParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "stateRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "state.get"
        },
        "params": {
          "$ref": "#/$defs/stateParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "additionalProperties": true
    },
    "helloResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "result": {
          "$ref": "#/$defs/helloResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": true,
      "not": {
        "required": [
          "error"
        ]
      }
    },
    "updateResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "result": {
          "$ref": "#/$defs/updateResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": true,
      "not": {
        "required": [
          "error"
        ]
      }
    },
    "clearResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "result": {
          "$ref": "#/$defs/clearResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": true,
      "not": {
        "required": [
          "error"
        ]
      }
    },
    "stateResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "result": {
          "$ref": "#/$defs/stateResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": true,
      "not": {
        "required": [
          "error"
        ]
      }
    },
    "errorResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                -32700,
                -32600,
                -32601,
                -32602,
                -32603,
                -32001,
                -32002,
                -32003,
                -32004,
                -32005,
                -32006
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": true,
      "not": {
        "required": [
          "result"
        ]
      }
    },
    "sourceUrl": {
      "type": "string",
      "maxLength": 2048,
      "description": "Optional empty string or absolute http/https URL with no credentials, or local file URL without authority. Maximum 2048 UTF-8 bytes; strict URI and decoded-control validation enforced at runtime."
    }
  }
}
